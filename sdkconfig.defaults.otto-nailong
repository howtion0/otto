# Apply after sdkconfig.defaults and sdkconfig.defaults.esp32s3 for this Otto build.
CONFIG_BOARD_TYPE_OTTO_ROBOT=y
CONFIG_USE_AFE_WAKE_WORD=n
CONFIG_USE_CUSTOM_WAKE_WORD=y
CONFIG_CUSTOM_WAKE_WORD="ni hao nai long"
CONFIG_CUSTOM_WAKE_WORD_DISPLAY="你好奶龙"
CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=20
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=n
CONFIG_SR_MN_CN_NONE=n
CONFIG_SR_MN_CN_MULTINET7_QUANT=y
